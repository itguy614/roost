{
  "identifier": "main",
  "description": "Roost dashboard and scoped project operations in the local main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-dashboard-snapshot",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-choose-project-directory",
    "allow-resolve-project-php",
    "allow-discover-project-queues",
    "allow-project-action"
  ]
}

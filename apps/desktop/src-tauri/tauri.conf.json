{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roost",
  "version": "0.1.0",
  "identifier": "dev.roost.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Roost", "width": 1016, "height": 670, "minWidth": 720, "minHeight": 460 }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self';"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"],
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
